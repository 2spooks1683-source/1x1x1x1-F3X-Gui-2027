	["Black"] = function()
		local player = game.Players.LocalPlayer local char = player.Character or player.CharacterAdded:Wait() local backpack = player:WaitForChild("Backpack") local function getF3XTool() for _, item in ipairs(backpack:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end for _, item in ipairs(char:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end return nil end local f3x = getF3XTool() if not f3x then return end local syncAPI = f3x.SyncAPI local serverEndpoint = syncAPI.ServerEndpoint local function setPartColor(part, color) local args = { [1] = "SyncColor", [2] = { [1] = { ["Part"] = part, ["Color"] = color, ["UnionColoring"] = false } } } serverEndpoint:InvokeServer(unpack(args)) end local function colorAllParts() local blackColor = Color3.fromRGB(0, 0, 0) for _, object in ipairs(workspace:GetDescendants()) do if object:IsA("BasePart") or object:IsA("UnionOperation") then task.spawn(function() setPartColor(object, blackColor) end) end end end colorAllParts()
	end,
	
	["Disco"] = function()
	    local LocalPlayer = game:GetService("Players").LocalPlayer local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait() local Backpack = LocalPlayer:FindFirstChild("Backpack") local function findHDAdminF3X(parent) if not parent then return nil end for _, item in ipairs(parent:GetChildren()) do if item:IsA("Tool") and (item.Name:find("Building") or item.Name:find("F3X") or item:FindFirstChild("SyncAPI", true)) then return item end end return nil end local f3xTool = findHDAdminF3X(Character) or findHDAdminF3X(Backpack) local SyncAPI = f3xTool:FindFirstChild("SyncAPI", true) local function invokeSyncAPI(action, ...) if SyncAPI:IsA("RemoteFunction") then return SyncAPI:InvokeServer(action, ...) elseif SyncAPI:IsA("BindableFunction") then return SyncAPI:Invoke(action, ...) end end local spawnCFrame = Character.HumanoidRootPart.CFrame * CFrame.new(0, 1.3, 0) local targetPart = invokeSyncAPI("CreatePart", "Normal", spawnCFrame, workspace) invokeSyncAPI("SyncAnchor", {{Part = targetPart, Anchored = true}}) invokeSyncAPI("SyncResize", {{Part = targetPart, CFrame = targetPart.CFrame, Size = Vector3.new(1000, 2, 1000)}}) pcall(function() invokeSyncAPI("SyncMaterial", {{Part = targetPart, Material = targetPart.Material, Transparency = 0.75}}) end) pcall(function() invokeSyncAPI("SyncCollision", {{Part = targetPart, CanCollide = false}}) end) local discoColors = { Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 0, 255), Color3.fromRGB(0, 0, 139), Color3.fromRGB(128, 0, 128), Color3.fromRGB(255, 192, 203), Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 255, 255) } task.spawn(function() while true do for _, color in ipairs(discoColors) do pcall(function() invokeSyncAPI("SyncColor", { {Part = targetPart, Color = color, UnionColoring = true} }) end) task.wait(0.3) end end end)
	end,
	
	["2014 Destroy"] = function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":unfog :fogcolor black") RequestCommand:InvokeServer(":time 0") task.wait(0.1) local player = game.Players.LocalPlayer local char = player.Character or player.CharacterAdded:Wait() local tool for _, v in ipairs(player:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end if not tool then for _, v in ipairs(game.ReplicatedStorage:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end if not tool then return end local remote = tool.SyncAPI.ServerEndpoint local function _(args) remote:InvokeServer(unpack(args)) end local function CreatePart(cf, parent) _({"CreatePart", "Normal", cf, parent}) end local function SetName(part, name) _({"SetName", {part}, name}) end local function AddMesh(part) _({"CreateMeshes", {{Part = part}}}) end local function SetMesh(part, id) _({"SyncMesh", {{Part = part, MeshId = "rbxassetid://" .. id}}}) end local function SetTexture(part, id) _({"SyncMesh", {{Part = part, TextureId = "rbxassetid://" .. id}}}) end local function MeshResize(part, size) _({"SyncMesh", {{Part = part, Scale = size}}}) end local function SetVertexColor(part, vec) _({"SyncMesh", {{Part = part, VertexColor = vec}}}) end local function SetLocked(part, bool) _({"SetLocked", {part}, bool}) end local function SetMaterial(part, mat) _({"SyncMaterial", {{Part = part, Material = mat}}}) end local function SetCollision(part, bool) _({"SyncCollision", {{Part = part, CanCollide = bool}}}) end local function CreatePointLight(part) _({"CreateLights", {{Part = part, LightType = "PointLight"}}}) end local function SyncPointLight(part, brightness, range) _({"SyncLighting", {{Part = part, LightType = "PointLight", Brightness = brightness, Range = range}}}) end local function Sky(texId) local pos = Vector3.new(0, -7, 0) CreatePart(CFrame.new(pos), workspace) for _, v in ipairs(workspace:GetDescendants()) do if v:IsA("BasePart") and not v:IsDescendantOf(char) and math.floor(v.Position.X) == 0 and math.floor(v.Position.Y) == -7 and math.floor(v.Position.Z) == 0 then SetName(v, "Sky") AddMesh(v) SetMesh(v, "111891702759441") SetTexture(v, texId) MeshResize(v, Vector3.new(97000, 97000, 97000)) SetVertexColor(v, Vector3.new(2.8, 2.8, 2.8)) SetMaterial(v, "Neon") SetCollision(v, false) CreatePointLight(v) SyncPointLight(v, 5, 8) SetLocked(v, true) end end end Sky("132458856080606") task.wait(0.2) local Players = game:GetService("Players") local ReplicatedStorage = game:GetService("ReplicatedStorage") local player = Players.LocalPlayer local tool local function findSyncAPITool() for _, v in pairs(player:GetDescendants()) do if v.Name == "SyncAPI" then return v.Parent end end for _, v in pairs(ReplicatedStorage:GetDescendants()) do if v.Name == "SyncAPI" then return v.Parent end end end tool = findSyncAPITool() if not tool then return end local remote = tool.SyncAPI.ServerEndpoint local function invoke(args) remote:InvokeServer(unpack(args)) end local function SetLocked(part, boolean) invoke({ "SetLocked", { part }, boolean }) end local function SpawnDecal(part, face) invoke({ "CreateTextures", { { Part = part, Face = face, TextureType = "Decal" } } }) end local function AddDecal(part, assetId, face) invoke({ "SyncTexture", { { Part = part, Face = face, TextureType = "Decal", Texture = "rbxassetid://" .. assetId } } }) end local function hasBlockedMesh(part) for _, child in ipairs(part:GetChildren()) do if child:IsA("SpecialMesh") or child:IsA("Mesh") then if tostring(child.MeshId):find("111891702759441") then return true end end end return false end local function SpamDecal(assetId) for _, v in pairs(workspace:GetDescendants()) do if v:IsA("BasePart") and not hasBlockedMesh(v) then task.spawn(function() SetLocked(v, false) for _, face in pairs(Enum.NormalId:GetEnumItems()) do SpawnDecal(v, face) AddDecal(v, assetId, face) end end) end end end SpamDecal("6147424071") task.wait(0.2) local player = game.Players.LocalPlayer local char = player.Character or player.CharacterAdded:Wait() local backpack = player:WaitForChild("Backpack") local function getF3XTool() for _, item in ipairs(backpack:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end for _, item in ipairs(char:GetChildren()) do if item:FindFirstChild("SyncAPI") then return item end end return nil end local f3x = getF3XTool() if not f3x then return end local syncAPI = f3x.SyncAPI local serverEndpoint = syncAPI.ServerEndpoint local function setPartColor(part, color) local args = { [1] = "SyncColor", [2] = { [1] = { ["Part"] = part, ["Color"] = color, ["UnionColoring"] = false } } } serverEndpoint:InvokeServer(unpack(args)) end local function colorAllParts() for _, object in ipairs(workspace:GetDescendants()) do if object:IsA("BasePart") or object:IsA("UnionOperation") then task.spawn(function() local randomColor = Color3.fromRGB(math.random(0, 255), math.random(0, 255), math.random(0, 255)) setPartColor(object, randomColor) end) end end end colorAllParts() task.wait(0.1) local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":unfog :fogcolor black") RequestCommand:InvokeServer(":music 126039082570864  :pitch 0.056 :volume 5")
