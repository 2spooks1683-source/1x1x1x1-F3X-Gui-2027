local ButtonActions = {
	["Small Sky"] = function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage") local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent RequestCommand:InvokeServer(":fog inf") task.wait(0.01) local player = game.Players.LocalPlayer local char = player.Character local tool for i, v in player:GetDescendants() do if v.Name == "SyncAPI" then tool = v.Parent end end for i, v in game.ReplicatedStorage:GetDescendants() do if v.Name == "SyncAPI" then tool = v.Parent end end local remote = tool.SyncAPI.ServerEndpoint function _(args) remote:InvokeServer(unpack(args)) end function SetMesh(part, meshid, vertexColor) local args = { [1] = "SyncMesh", [2] = { [1] = { ["Part"] = part, ["MeshId"] = "rbxassetid://"..meshid, ["VertexColor"] = vertexColor or Vector3.new(1, 1, 1) } } } _(args) end function SetTexture(part, texid) local args = { [1] = "SyncMesh", [2] = { [1] = { ["Part"] = part, ["TextureId"] = "rbxassetid://"..texid } } } _(args) end table_insert = table.insert function MeshResize(part, size) local args = { [1] = "SyncMesh", [2] = { [1] = { ["Part"] = part, ["Scale"] = size } } } _(args) end function SetLocked(part, boolean) local args = { [1] = "SetLocked", [2] = { [1] = part }, [3] = boolean } _(args) end function SetTrans(part, int) local args = { [1] = "SyncMaterial", [2] = { [1] = { ["Part"] = part, ["Transparency"] = int } } } _(args) end function Color(part, color) local args = { [1] = "SyncColor", [2] = { [1] = { ["Part"] = part, ["Color"] = color, ["UnionColoring"] = false } } } _(args) end function SyncLighting(part, brightness) local args = { [1] = "SyncLighting", [2] = { [1] = { ["Part"] = part, ["LightType"] = "PointLight", ["Brightness"] = brightness } } } _(args) end function UpdateSky() for i, v in game.Workspace:GetDescendants() do if v:IsA("BasePart") and v.Name == "Sky" then local specialMesh = v:FindFirstChildOfClass("SpecialMesh") if specialMesh then local currentScale = specialMesh.Scale local currentTexture = specialMesh.TextureId:match("%d+") or "" local currentMeshId = specialMesh.MeshId:match("%d+") or "111891702759441" local targetScale local targetVertexColor local targetTransparency if currentScale.X >= 105000 then targetScale = Vector3.new(11000, 11000, 11000) targetVertexColor = Vector3.new(0, 0, 0) targetTransparency = 0 elseif currentScale.X <= 100000 then targetScale = Vector3.new(10000, 10000, 10000) targetVertexColor = Vector3.new(2.8, 2.8, 2.8) end if targetScale then if currentTexture ~= "" then SetTexture(v, currentTexture) end SetMesh(v, currentMeshId, targetVertexColor) MeshResize(v, targetScale) SetLocked(v, true) SetTrans(v, targetTransparency) local matArgs = { [1] = "SyncMaterial", [2] = { [1] = { ["Part"] = v, ["Material"] = Enum.Material.Neon } } } _(matArgs) Color(v, Color3.fromRGB(255, 255, 255)) SyncLighting(v, 0) end end end end end UpdateSky()
	end,
	
