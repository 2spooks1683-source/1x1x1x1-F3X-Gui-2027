	["Raining Heads"] = function()
		local player = game.Players.LocalPlayer; local char = player.Character or player.CharacterAdded:Wait(); local tool; for i, v in player:GetDescendants() do if v.Name == "SyncAPI" then tool = v.Parent end; end; for i, v in game.ReplicatedStorage:GetDescendants() do if v.Name == "SyncAPI" then tool = v.Parent end; end; local remote = tool.SyncAPI.ServerEndpoint; function _(args) remote:InvokeServer(unpack(args)); end; function SetCollision(part, boolean) local args = {[1] = "SyncCollision", [2] = {[1] = {["Part"] = part, ["CanCollide"] = boolean}}}; _(args); end; function SetAnchor(boolean, part) local args = {[1] = "SyncAnchor", [2] = {[1] = {["Part"] = part, ["Anchored"] = boolean}}}; _(args); end; function CreatePart(cf) local args = {[1] = "CreatePart", [2] = "Normal", [3] = cf, [4] = workspace}; _(args); task.wait(0.05); end; function Resize(part, size, cf) local args = {[1] = "SyncResize", [2] = {[1] = {["Part"] = part, ["CFrame"] = cf, ["Size"] = size}}}; _(args); end; function AddMesh(part) local args = {[1] = "CreateMeshes", [2] = {[1] = {["Part"] = part}}}; _(args); end; function SetMesh(part, meshid) local args = {[1] = "SyncMesh", [2] = {[1] = {["Part"] = part, ["MeshId"] = "rbxassetid://" .. meshid}}}; _(args); end; function MeshResize(part, size) local args = {[1] = "SyncMesh", [2] = {[1] = {["Part"] = part, ["Scale"] = size}}}; _(args); end; function SetColor(part, color) local args = {[1] = "SyncColor", [2] = {[1] = {["Part"] = part, ["Color"] = color}}}; _(args); end; function SetName(part, stringg) local args = {[1] = "SetName", [2] = {[1] = workspace.Part}, [3] = stringg}; _(args); end; local function createRainToads() while true do task.wait(0.1); if player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then local hrpcf = player.Character.HumanoidRootPart.CFrame; local x = hrpcf.x; local z = hrpcf.z; local randint = math.random(-600, 600); local randint2 = math.random(-600, 600); local xloc = randint + x; local zloc = randint2 + z; local cf = player.Character.HumanoidRootPart.CFrame.y + 400; task.spawn(function() CreatePart(CFrame.new(math.floor(xloc), math.random(cf, cf + 400), math.floor(zloc))); for i, v in game.Workspace:GetDescendants() do if v.Name == "Part" and v.Parent == workspace and v.CFrame.x == math.floor(xloc) and v.CFrame.z == math.floor(zloc) then SetName(v, "HeadPart"); SetAnchor(false, v); Resize(v, Vector3.new(2, 2, 2), v.CFrame); AddMesh(v); SetMesh(v, "27111874"); MeshResize(v, Vector3.new(1.25, 1.25, 1.25)); SetCollision(v, true); local colorChoice = math.random(1, 3); if colorChoice == 1 then SetColor(v, Color3.fromRGB(255, 255, 0)); elseif colorChoice == 2 then SetColor(v, Color3.fromRGB(255, 205, 155)); else SetColor(v, Color3.fromRGB(128, 128, 128)); end; v.Orientation = Vector3.new(0, 0, 0); local sound = Instance.new("Sound", v); sound.SoundId = "rbxassetid://79348298352567"; sound.Volume = 1; sound.PlayOnRemove = true; sound:Destroy(); end; end; end); else task.wait(1); end; end; end; coroutine.wrap(createRainToads)();
	end,
	
	["Ambient"] = function()
		local Players = game:GetService("Players"); local player = Players.LocalPlayer; local character = player.Character or player.CharacterAdded:Wait(); local rootPart = character:WaitForChild("HumanoidRootPart"); local function getEndpoint() local containers = {player.Backpack, character}; for _, container in ipairs(containers) do for _, item in ipairs(container:GetChildren()) do local syncAPI = item:FindFirstChild("SyncAPI"); if syncAPI then return syncAPI:FindFirstChild("ServerEndpoint"); end; end; end; return nil; end; local endpoint = getEndpoint(); if not endpoint then return; end; local targetCFrame = rootPart.CFrame * CFrame.new(0, -3.5, 0); local part = endpoint:InvokeServer("CreatePart", "Normal", targetCFrame, workspace); if not part then return; end; endpoint:InvokeServer("SyncTransparency", {{ Part = part, Transparency = 1 }}); endpoint:InvokeServer("SyncCollision", {{ Part = part, CanCollide = false }}); endpoint:InvokeServer("SyncColor", {{ Part = part, Color = Color3.fromRGB(255, 0, 0), UnionColoring = false }}); endpoint:InvokeServer("CreateLights", {{ Part = part, LightType = "PointLight" }}); endpoint:InvokeServer("SyncLighting", {{ Part = part, LightType = "PointLight", Range = 120, Brightness = 1.2, Color = Color3.fromRGB(255, 0, 0) }});
	end,
	
