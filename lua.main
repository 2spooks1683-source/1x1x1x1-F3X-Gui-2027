for buttonName, actionFunction in pairs(ButtonActions) do
	local foundButton = MainFrame:FindFirstChild(buttonName)
	if foundButton and foundButton:IsA("TextButton") then
		foundButton.MouseButton1Click:Connect(actionFunction)
	else
	end
end
