local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Origin1x1x1x1Gui"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 440, 0, 365)
MainFrame.Position = UDim2.new(0.5, -220, 0.5, -182)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local RedColor = Color3.fromRGB(255, 25, 0)
local BlackText = Color3.fromRGB(0, 0, 0)

local function createButton(name, text, pos, size)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = text
	btn.Position = pos
	btn.Size = size
	btn.BackgroundColor3 = RedColor
	btn.BorderSizePixel = 0
	btn.TextColor3 = BlackText
	btn.Font = Enum.Font.SourceSansBold
	btn.TextScaled = true
	
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 3)
	padding.PaddingBottom = UDim.new(0, 3)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 4)
	padding.Parent = btn
	
	btn.Parent = MainFrame
	return btn
end

createButton("Small Sky", "Small Sky", UDim2.new(0, 28, 0, 12), UDim2.new(0, 118, 0, 34))
createButton("Btools", "Btools", UDim2.new(0, 265, 0, 12), UDim2.new(0, 148, 0, 34))

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Name = "TitleBanner"
TitleLabel.Text = "1x1x1x1 gui but more original"
TitleLabel.Position = UDim2.new(0, 0, 0, 58)
TitleLabel.Size = UDim2.new(1, 0, 0, 32)
TitleLabel.BackgroundColor3 = RedColor
TitleLabel.BorderSizePixel = 0
TitleLabel.TextColor3 = BlackText
TitleLabel.Font = Enum.Font.SourceSansBold
TitleLabel.TextScaled = true
local titlePad = Instance.new("UIPadding")
titlePad.PaddingLeft = UDim.new(0, 15)
titlePad.PaddingRight = UDim.new(0, 15)
titlePad.Parent = TitleLabel
TitleLabel.Parent = MainFrame

